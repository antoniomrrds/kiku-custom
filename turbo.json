{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".vitepress/dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "@repo/note#build"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "package": {
      "dependsOn": ["^package"]
    },
    "copy-dist": {
      "dependsOn": ["^copy-dist"]
    },
    "update-note-type": {
      "dependsOn": ["^update-note-type"]
    },
    "generate-template": {
      "dependsOn": ["^generate-template"]
    },
    "apply": {
      "dependsOn": ["^apply"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
