{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-explicit-any": "warn",
    "import/no-relative-parent-imports": "warn",
    "typescript/no-non-null-assertion": "error"
  },
  "env": {
    "builtin": true
  },
  "options": {
    "typeAware": true
  }
}
