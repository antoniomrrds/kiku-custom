{
  "name": "kiku",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "package": "turbo run package --force",
    "dev": "turbo run dev --env-mode=loose",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "copy-anki-build": "turbo run copy-anki-build",
    "update-note-type": "turbo run update-note-type",
    "generate-template": "turbo run generate-template",
    "apply": "turbo run apply --force"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "turbo": "^2.9.14",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.1.2"
}
