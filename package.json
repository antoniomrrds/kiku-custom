{
  "name": "kiku",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "package": "turbo run package --force",
    "dev": "turbo run dev --env-mode=loose",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "copy-anki-build": "turbo run copy-anki-build",
    "update-note-type": "turbo run update-note-type",
    "generate-template": "turbo run generate-template",
    "apply": "turbo run apply --force"
  },
  "devDependencies": {
    "@tailwindcss/language-server": "^0.14.29",
    "@typescript/typescript6": "^6.0.2",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.2"
}
