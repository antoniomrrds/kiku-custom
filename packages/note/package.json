{
  "name": "@repo/note",
  "version": "1.10.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/_kiku.js",
      "types": "./dist/types/src/index.d.ts"
    },
    "./_kiku_worker.js": {
      "import": "./dist/_kiku_worker.js",
      "types": "./dist/types/src/worker/_kiku_worker.d.ts"
    },
    "./_kiku.css": "./dist/_kiku.css"
  },
  "scripts": {
    "dev": "vite ./preview/anki",
    "build": "tsc -b && vite build",
    "build:fast": "FAST_BUILD=true vite build",
    "typecheck": "tsc -b",
    "copy-anki-build": "vite-node ./script/copy-anki-build.ts",
    "update-note-type": "vite-node ./script/update-note-type.ts",
    "generate-template": "vite-node ./script/generate-template.ts",
    "test": "vitest run",
    "apply": "FAST_BUILD=true vite build && vite-node ./script/generate-template.ts && vite-node ./script/copy-anki-build.ts && vite-node ./script/update-note-type.ts",
    "package": "vite-node ./script/package.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.8.0",
    "@types/serve-static": "^2.2.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "daisyui": "^5.5.19",
    "extract-zip": "^2.0.1",
    "jsdom": "^29.1.1",
    "serve-static": "^2.2.1",
    "tailwindcss": "^4.3.0",
    "tar": "^7.5.15",
    "vite": "^8.0.13",
    "vite-node": "^6.0.0",
    "vite-plugin-circular-dependency": "^0.6.0",
    "vite-plugin-dts": "^5.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.6"
  }
}
