{
  "name": "@repo/note",
  "private": true,
  "version": "1.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite ./preview/anki",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "copy-dist": "node ./script/copy-dist.ts",
    "update-note-type": "npx vite-node ./script/update-note-type.ts",
    "generate-template": "npx vite-node ./script/generate-template.ts",
    "apply": "pnpm run build && pnpm run generate-template && pnpm run copy-dist && pnpm run update-note-type",
    "package": "npx vite-node ./script/package.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/serve-static": "^2.2.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "daisyui": "^5.5.19",
    "extract-zip": "^2.0.1",
    "serve-static": "^2.2.1",
    "tailwindcss": "^4.2.1",
    "tar": "^7.5.11",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vite-node": "^5.3.0",
    "vite-plugin-circular-dependency": "^0.5.0",
    "vite-plugin-solid": "^2.11.10"
  }
}
