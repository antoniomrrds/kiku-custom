{
  "name": "@repo/note",
  "private": true,
  "version": "1.7.2",
  "type": "module",
  "scripts": {
    "dev": "vite ./preview/anki",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "copy-dist": "node ./script/copy-dist.ts",
    "update-note-type": "npx vite-node ./script/update-note-type.ts",
    "generate-template": "npx vite-node ./script/generate-template.ts",
    "apply": "pnpm run build && pnpm run generate-template && pnpm run copy-dist && pnpm run update-note-type",
    "package": "npx vite-node ./script/package.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/express": "^5.0.5",
    "@types/node": "^24.6.0",
    "cheerio": "^1.1.2",
    "daisyui": "^5.3.10",
    "express": "^5.1.0",
    "extract-zip": "^2.0.1",
    "tailwindcss": "^4.1.16",
    "tar": "^7.5.2",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.1.14",
    "vite-node": "^3.2.4",
    "vite-plugin-circular-dependency": "^0.5.0",
    "vite-plugin-solid": "^2.11.8"
  }
}
