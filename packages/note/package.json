{
  "name": "@repo/note",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./*"
  },
  "exports": {
    ".": {
      "import": "./dist/_kiku.js",
      "types": "./dist/types/src/index.d.ts"
    },
    "./_kiku_worker.js": {
      "import": "./dist/_kiku_worker.js",
      "types": "./dist/types/src/worker/_kiku_worker.d.ts"
    },
    "./_kiku.css": "./dist/_kiku.css"
  },
  "scripts": {
    "dev": "vite ./preview/anki",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "oxfmt --check",
    "download-fonts": "npx vite-node ./preprocess/download-fonts.ts",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "build": "tsc -b && COMMIT_SHA=${VERCEL_GIT_COMMIT_SHA:-$(git rev-parse HEAD)} vite build",
    "build:fast": "FAST_BUILD=true vite build",
    "copy-anki-build": "vite-node ./script/copy-anki-build.ts",
    "update-note-type": "vite-node ./script/update-note-type.ts",
    "generate-template": "vite-node ./script/generate-template.ts",
    "build:win": "tsc -b && vite build",
    "apply:win": "pnpm run build:win && pnpm run generate-template && pnpm run copy-anki-build && pnpm run update-note-type",
    "apply:fast:win": "vite build && pnpm run generate-template && pnpm run copy-anki-build && pnpm run update-note-type",
    "apply": "tsc -b && COMMIT_SHA=${VERCEL_GIT_COMMIT_SHA:-$(git rev-parse HEAD)} vite build && vite-node ./script/generate-template.ts && vite-node ./script/copy-anki-build.ts && vite-node ./script/update-note-type.ts",
    "apply:fast": "FAST_BUILD=true vite build && vite-node ./script/generate-template.ts && vite-node ./script/copy-anki-build.ts && vite-node ./script/update-note-type.ts",
    "package": "vite-node ./script/package.ts",
    "plugin:symlink": "vite-node ./script/plugin.ts symlink",
    "plugin:copy": "vite-node ./script/plugin.ts copy",
    "update-tailwind-property": "node ./script/update-tailwind-property.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@tailwindcss/language-server": "^0.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.5",
    "@types/serve-static": "^2.2.0",
    "chalk": "^5.6.2",
    "unzipper": "^0.12.3",
    "cheerio": "^1.2.0",
    "@types/unzipper": "^0.10.11",
    "daisyui": "^5.7.0",
    "extract-zip": "^2.0.1",
    "jsdom": "^29.1.1",
    "serve-static": "^2.2.1",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0",
    "vite-plugin-circular-dependency": "^0.6.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10"
  }
}